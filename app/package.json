{
  "name": "sats-seo-gis",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/preview.mjs out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:seo": "node scripts/seo/check.mjs",
    "check:urls": "node scripts/seo/check.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "test:budgets": "playwright test tests/budgets.spec.js",
    "lhci": "lhci autorun",
    "lhci:mobile": "lhci autorun --config=./lighthouserc.mobile.cjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "next": "^15.5.0",
    "pmtiles": "4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.14.0",
    "@next/eslint-plugin-next": "^15.5.28",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}

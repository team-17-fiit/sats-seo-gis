# Skopíruj do .env (nie je v gite). Hodnoty nižšie sú pre lokálny vývoj.

# --- Databáza (docker compose) ---
POSTGRES_DB=satsgis
POSTGRES_USER=satsgis
POSTGRES_PASSWORD=satsgis
POSTGRES_PORT=5432
DATABASE_URL=postgresql://satsgis:satsgis@localhost:5432/satsgis

# --- API (backend/) ---
# postgis = čítať z DB, file = čítať z data/seed + app/public/data (beh bez Dockeru)
REPOSITORY=file
CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# --- Frontend (app/) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Metriky (nechaj prázdne lokálne; v CI ako GitHub Secrets) ---
PSI_API_KEY=
WPT_API_KEY=
